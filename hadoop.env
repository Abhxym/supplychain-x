# The apache/hadoop image turns FILE.XML_key=value into <property> entries in that xml file.

# where clients find the filesystem
CORE-SITE.XML_fs.defaultFS=hdfs://namenode:8020

HDFS-SITE.XML_dfs.namenode.rpc-address=namenode:8020
# every block is stored on both datanodes, so one can die without losing data
HDFS-SITE.XML_dfs.replication=2
# DEMO SETTING: 1MB blocks (real clusters use 128MB) so our few-MB files get split into several
# blocks you can see spread across the datanodes. Tiny blocks are bad at real scale - each block
# costs namenode memory - but with ~25MB of data it is the only way to watch HDFS split a file.
HDFS-SITE.XML_dfs.blocksize=1m
HDFS-SITE.XML_dfs.namenode.fs-limits.min-block-size=1m
# no kerberos / permission checks in a local dev cluster
HDFS-SITE.XML_dfs.permissions.enabled=false
HDFS-SITE.XML_dfs.webhdfs.enabled=true
# DEMO SETTING: declare a silent datanode dead after ~60s instead of the default ~10.5 min
# (dead after 2 x recheck-interval + 10 x heartbeat = 2 x 15s + 10 x 3s), so the failover demo is watchable
HDFS-SITE.XML_dfs.namenode.heartbeat.recheck-interval=15000
